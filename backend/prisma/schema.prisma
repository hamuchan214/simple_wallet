// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["views"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  Transaction Transaction[]
  CustomTag   CustomTag[]
  SavingsGoal SavingsGoal[]
  Budget      Budget[]

  @@map("user")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  amount      Int
  description String?
  date        DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  SystemTagsOnTransactions SystemTagsOnTransactions[]
  CustomTagsOnTransactions CustomTagsOnTransactions[]

  @@index([userId])
  @@map("transaction")
}

model SystemTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  SystemTagsOnTransactions SystemTagsOnTransactions[]

  @@map("system_tag")
}

model CustomTag {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  name      String   @unique
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  CustomTagsOnTransactions CustomTagsOnTransactions[]
  BudgetCategory           BudgetCategory[]

  @@unique([name, userId])
  @@index([userId])
  @@map("custom_tag")
}

// システムタグとトランザクションの中間テーブル
model SystemTagsOnTransactions {
  transactionId Int         @map("transaction_id")
  tagId         Int         @map("tag_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  systemTag     SystemTag   @relation(fields: [tagId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@id([transactionId, tagId])
  @@index([transactionId])
  @@index([tagId])
  @@map("system_tags_on_transaction")
}

// カスタムタグとトランザクションの中間テーブル
model CustomTagsOnTransactions {
  transactionId Int         @map("transaction_id")
  tagId         Int         @map("tag_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customTag     CustomTag   @relation(fields: [tagId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@id([transactionId, tagId])
  @@index([transactionId])
  @@index([tagId])
  @@map("custom_tags_on_transaction")
}

// トランザクションとタグの結合ビュー
view TransactionWithTags {
  transactionId Int      @map("transaction_id")
  userId        String   @map("user_id")
  amount        Int
  description   String?
  date          DateTime
  systemTagId   Int?     @map("system_tag_id")
  customTagId   Int?     @map("custom_tag_id")
  tagName       String?  @map("tag_name")

  @@id([transactionId])
  @@map("transaction_with_tags")
}

// 貯金の目標設定
model SavingsGoal {
  id            Int       @id @default(autoincrement())
  userId        String    @map("user_id")
  name          String
  targetAmount  Int       @map("target_amount")
  currentAmount Int       @default(0) @map("current_amount")
  deadline      DateTime?
  isCompleted   Boolean   @default(false) @map("is_completed")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id])
  savingsHistory SavingsHistory[]

  @@index([userId])
  @@map("savings_goal")
}

// 貯金の履歴
model SavingsHistory {
  id          Int      @id @default(autoincrement())
  goalId      Int      @map("goal_id")
  amount      Int
  description String?
  date        DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("savings_history")
}

// 予算管理
model Budget {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  name      String
  amount    Int
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id])
  budgetCategory BudgetCategory[]

  @@index([userId])
  @@map("budget")
}

// 予算カテゴリー
model BudgetCategory {
  id         Int      @id @default(autoincrement())
  budgetId   Int      @map("budget_id")
  categoryId Int      @map("category_id")
  amount     Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  budget   Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category CustomTag @relation(fields: [categoryId], references: [id])

  @@unique([budgetId, categoryId])
  @@index([budgetId])
  @@index([categoryId])
  @@map("budget_category")
}

// 予算の使用状況を表示するビュー
view BudgetUsage {
  budgetId     Int      @map("budget_id")
  userId       String   @map("user_id")
  categoryId   Int      @map("category_id")
  categoryName String   @map("category_name")
  budgetAmount Int      @map("budget_amount")
  usedAmount   Int      @map("used_amount")
  remaining    Int
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")

  @@id([budgetId, categoryId])
  @@map("budget_usage")
}
